# Dolibarr MCP Server Configuration
# 
# IMPORTANT: This .env file is only used in DEVELOPMENT mode.
# For PRODUCTION deployment, set these variables at the system level
# or use the provided start scripts (start-production.sh / start-production.ps1)

# Dolibarr API Configuration (REQUIRED)
NITRO_DOLI_URL=http://localhost:4000/api/index.php
NITRO_DOLI_KEY=your-dolibarr-api-key-here

# Nitro Server Configuration (OPTIONAL)
NITRO_HOST=0.0.0.0
NITRO_PORT=3000

# Development Notes:
# - Copy this file to .env and update with your values
# - Never commit .env with real credentials to version control
# - In production, use system environment variables instead